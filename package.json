    "seed:demo": "node scripts/seed-demo.js",
    "dev:demo": "node server.js --local --demo"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "postgres": "^3.4.9"
  },
