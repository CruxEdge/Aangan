{
  "name": "aangan-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend tools for the Aangan Studio phone enquiry voice agent",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "start": "node server.js",
    "simulate": "node scripts/simulate.js",
    "reset": "rm -rf .data",
    "users": "node scripts/users.js",
    "dev": "node server.js --local",
